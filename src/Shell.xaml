<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Border x:Name="WindowCard" Margin="14" CornerRadius="30"
            BorderBrush="#14121E" BorderThickness="1"
            SnapsToDevicePixels="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0A0812" Offset="0" />
                <GradientStop Color="#120F1E" Offset="0.5" />
                <GradientStop Color="#07060B" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="14" Direction="270"
                              Color="#000000" Opacity="0.55" />
        </Border.Effect>

        <Grid>
            <!-- ambient colour wash, kept away from the rounded corners -->
            <Canvas IsHitTestVisible="False" ClipToBounds="True" Opacity="0.55">
                <Ellipse Canvas.Left="720" Canvas.Top="-40" Width="420" Height="420">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#2A8B5CF6" Offset="0" />
                            <GradientStop Color="#008B5CF6" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Canvas.Left="-60" Canvas.Top="420" Width="460" Height="460">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#1A22D3EE" Offset="0" />
                            <GradientStop Color="#0022D3EE" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Canvas.Left="300" Canvas.Top="620" Width="380" Height="380">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#1AF472B6" Offset="0" />
                            <GradientStop Color="#00F472B6" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Canvas>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ============================== TITLE BAR ============================== -->
                <Grid x:Name="TitleBar" Background="Transparent">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="24,0,0,0" IsHitTestVisible="False">
                        <Border Width="38" Height="38" CornerRadius="12"
                                Background="{StaticResource BrandGradientBrush}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                <Border Width="3" Height="12" CornerRadius="2" Background="White"
                                        Margin="1,0" VerticalAlignment="Center" />
                                <Border Width="3" Height="20" CornerRadius="2" Background="White"
                                        Margin="1,0" VerticalAlignment="Center" />
                                <Border Width="3" Height="16" CornerRadius="2" Background="White"
                                        Margin="1,0" VerticalAlignment="Center" />
                                <Border Width="3" Height="10" CornerRadius="2" Background="#CCFFFFFF"
                                        Margin="1,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Aurora" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{StaticResource OnSurfaceBrush}" Margin="12,0,0,0" />
                        <Border Background="#0F141C" CornerRadius="10" Padding="8,2.5"
                                VerticalAlignment="Center" Margin="10,1,0,0"
                                BorderBrush="#2A8B5CF6" BorderThickness="1">
                            <TextBlock Text="AURORA" FontFamily="{StaticResource TextFont}"
                                       FontSize="9" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="0,0,14,0">
                        <Button x:Name="MinimizeButton" Style="{StaticResource WindowButtonStyle}"
                                ToolTip="Свернуть">
                            <TextBlock Text="&#xE921;" FontFamily="{StaticResource IconFont}" FontSize="11" />
                        </Button>
                        <Button x:Name="CloseButton" Style="{StaticResource WindowButtonStyle}"
                                Margin="2,0,0,0" ToolTip="Закрыть">
                            <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="11" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ============================== VIEW HOST ============================== -->
                <Grid x:Name="ViewHost" Grid.Row="1" />

                <!-- ============================== SNACKBAR ============================== -->
                <Border x:Name="ToastBorder" Grid.RowSpan="2" Background="#14121E"
                        CornerRadius="20" Padding="20,12" Opacity="0"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="0,0,0,28" IsHitTestVisible="False"
                        BorderBrush="#2AFFFFFF" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270"
                                          Color="#000000" Opacity="0.7" />
                    </Border.Effect>
                    <TextBlock x:Name="ToastText" FontFamily="{StaticResource TextFont}"
                               FontSize="13.5" Foreground="#FFF7F2FF" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</Grid>