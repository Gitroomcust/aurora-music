<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Border x:Name="WindowCard" Margin="14" CornerRadius="28"
            BorderBrush="#221D1B20" BorderThickness="1"
            SnapsToDevicePixels="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFFDFBFF" Offset="0" />
                <GradientStop Color="#FFF9F5FF" Offset="0.48" />
                <GradientStop Color="#FFFFF9F7" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="10" Direction="270"
                              Color="#552D1E55" Opacity="0.30" />
        </Border.Effect>

        <Grid>
            <!-- soft colour wash, kept away from the rounded corners -->
            <Canvas IsHitTestVisible="False" ClipToBounds="True" Opacity="0.75">
                <Ellipse Canvas.Left="760" Canvas.Top="24" Width="340" Height="340">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#55D7C6FF" Offset="0" />
                            <GradientStop Color="#00D7C6FF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Canvas.Left="10" Canvas.Top="440" Width="300" Height="300">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#44FFD7C9" Offset="0" />
                            <GradientStop Color="#00FFD7C9" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Canvas>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="54" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ============================== TITLE BAR ============================== -->
                <Grid x:Name="TitleBar" Background="Transparent">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="24,0,0,0" IsHitTestVisible="False">
                        <Border Width="34" Height="34" CornerRadius="12"
                                Background="{StaticResource BrandGradientBrush}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                <Border Width="3" Height="10" CornerRadius="2" Background="White"
                                        Margin="1,0" VerticalAlignment="Center" />
                                <Border Width="3" Height="18" CornerRadius="2" Background="White"
                                        Margin="1,0" VerticalAlignment="Center" />
                                <Border Width="3" Height="13" CornerRadius="2" Background="White"
                                        Margin="1,0" VerticalAlignment="Center" />
                                <Border Width="3" Height="7" CornerRadius="2" Background="#CCFFFFFF"
                                        Margin="1,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Lumen" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{StaticResource OnSurfaceBrush}" Margin="11,0,0,1" />
                        <Border Background="#0F6850E8" CornerRadius="8" Padding="7,2.5"
                                VerticalAlignment="Center" Margin="9,1,0,0">
                            <TextBlock Text="LOCAL" FontFamily="{StaticResource TextFont}"
                                       FontSize="9" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="0,0,13,0">
                        <Button x:Name="MinimizeButton" Style="{StaticResource WindowButtonStyle}"
                                ToolTip="Свернуть">
                            <TextBlock Text="&#xE921;" FontFamily="{StaticResource IconFont}" FontSize="11" />
                        </Button>
                        <Button x:Name="CloseButton" Style="{StaticResource WindowButtonStyle}"
                                Margin="2,0,0,0" ToolTip="Закрыть">
                            <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="11" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ============================== VIEW HOST ============================== -->
                <Grid x:Name="ViewHost" Grid.Row="1" />

                <!-- ============================== SNACKBAR ============================== -->
                <Border x:Name="ToastBorder" Grid.RowSpan="2" Background="#F21C1B1F"
                        CornerRadius="18" Padding="18,11" Opacity="0"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="0,0,0,26" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="270"
                                          Color="#33000000" Opacity="0.8" />
                    </Border.Effect>
                    <TextBlock x:Name="ToastText" FontFamily="{StaticResource TextFont}"
                               FontSize="13" Foreground="#FFF9F5FF" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</Grid>
