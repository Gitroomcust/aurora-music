<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent" Margin="26,15,26,18">

    <Grid.RowDefinitions>
        <RowDefinition Height="52" />
        <RowDefinition Height="14" />
        <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ============================== HEADER ============================== -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button x:Name="BackButton" Style="{StaticResource IconButtonStyle}"
                Width="42" Height="42" VerticalAlignment="Center" ToolTip="Назад">
            <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" FontSize="15" />
        </Button>

        <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
            <TextBlock Text="Локальная музыка" Style="{StaticResource H1TextStyle}" FontSize="25" />
            <TextBlock x:Name="FolderPathText" Text="Папка не выбрана"
                       Style="{StaticResource CaptionTextStyle}" FontSize="11.5"
                       TextTrimming="CharacterEllipsis" MaxWidth="620"
                       HorizontalAlignment="Left" Margin="0,1,0,0" />
        </StackPanel>

        <Button x:Name="ChooseFolderButton" Grid.Column="2" Style="{StaticResource PillButtonStyle}">
            <StackPanel Orientation="Horizontal">
                <Viewbox Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Path Fill="White"
                          Data="M2.5,7 L2.5,5.5 C2.5,4.4 3.4,3.5 4.5,3.5 L8.5,3.5 C8.9,3.5 9.3,3.7 9.6,4 L11.2,6 L19.5,6 C20.6,6 21.5,6.9 21.5,8 L21.5,18 C21.5,19.1 20.6,20 19.5,20 L4.5,20 C3.4,20 2.5,19.1 2.5,18 Z" />
                </Viewbox>
                <TextBlock x:Name="ChooseFolderButtonText" Text="Выбрать папку"
                           FontFamily="{StaticResource TextFont}" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Button>
    </Grid>

    <!-- ============================== CONTENT ============================== -->
    <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== NOW PLAYING ==================== -->
        <Border x:Name="NowPlayingCard" Style="{StaticResource CardStyle}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="246" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border CornerRadius="24" ClipToBounds="True">
                    <Grid>
                        <Border CornerRadius="24">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#27203B" Offset="0" />
                                    <GradientStop Color="#4B3B8C" Offset="0.55" />
                                    <GradientStop Color="#E4718B" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <Grid x:Name="ArtDecor">
                            <Canvas IsHitTestVisible="False">
                                <Ellipse Width="262" Height="262" Canvas.Left="55" Canvas.Top="34"
                                         Stroke="#22FFFFFF" StrokeThickness="1" />
                                <Ellipse Width="194" Height="194" Canvas.Left="89" Canvas.Top="68"
                                         Stroke="#18FFFFFF" StrokeThickness="1" />
                                <Ellipse Width="128" Height="128" Canvas.Left="122" Canvas.Top="101"
                                         Fill="#15FFFFFF" />
                            </Canvas>
                            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}"
                                       FontSize="57" Foreground="#EFFFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,-8,0,0" />
                            <TextBlock Text="LUMEN SESSION" FontFamily="{StaticResource TextFont}"
                                       FontSize="9" FontWeight="SemiBold" Foreground="#80FFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,113,0,0" />
                        </Grid>

                        <Border x:Name="CoverLayer" CornerRadius="24" Opacity="0"
                                Background="Transparent" />

                        <Border CornerRadius="24" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0.45" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0" />
                                    <GradientStop Color="#660B0714" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <Border Background="#40FFFFFF" CornerRadius="11" Padding="9,5"
                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,14,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="NowPlayingDot" Width="5" Height="5"
                                         Fill="#DFFFFFFF" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock x:Name="NowPlayingBadgeText" Text="ГОТОВО К ЗАПУСКУ"
                                           FontFamily="{StaticResource TextFont}" FontSize="9"
                                           FontWeight="SemiBold" Foreground="White" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="LOCAL FILE" FontFamily="{StaticResource TextFont}"
                                   FontSize="9" FontWeight="SemiBold" Foreground="#A6FFFFFF"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                   Margin="0,0,15,13" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="3,14,3,0">
                    <TextBlock x:Name="NowTitleText" Text="Ничего не играет"
                               Style="{StaticResource H2TextStyle}" FontSize="21"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="NowArtistText" Text="Выберите папку и запустите трек"
                               Style="{StaticResource CaptionTextStyle}" FontSize="12.5"
                               TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />

                    <Slider x:Name="SeekSlider" Style="{StaticResource SeekSliderStyle}"
                            Minimum="0" Maximum="100" Value="0" Margin="0,9,0,0"
                            IsEnabled="False" />
                    <Grid Margin="1,-1,1,0">
                        <TextBlock x:Name="CurrentTimeText" Text="0:00"
                                   Style="{StaticResource CaptionTextStyle}" FontSize="10.5" />
                        <TextBlock x:Name="DurationText" Text="0:00"
                                   Style="{StaticResource CaptionTextStyle}" FontSize="10.5"
                                   HorizontalAlignment="Right" />
                    </Grid>

                    <StackPanel x:Name="TransportPanel" Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="0,8,0,0"
                                IsEnabled="False">
                        <Button x:Name="PreviousButton" Style="{StaticResource IconButtonStyle}"
                                Width="40" Height="40" Margin="0,8,10,0"
                                Background="#F7F2FE" ToolTip="Предыдущий трек">
                            <TextBlock Text="&#xE892;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                        </Button>

                        <Button x:Name="PlayButton" Style="{StaticResource BareButtonStyle}"
                                Width="56" Height="56" ToolTip="Воспроизвести">
                            <Grid Width="56" Height="56" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="PlayButtonScale" />
                                </Grid.RenderTransform>
                                <Border CornerRadius="28" Background="{StaticResource PrimaryGradientBrush}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="5" Direction="270"
                                                          Color="#6850E8" Opacity="0.38" />
                                    </Border.Effect>
                                    <TextBlock x:Name="PlayGlyph" Text="&#xE768;"
                                               FontFamily="{StaticResource IconFont}" FontSize="18"
                                               Foreground="White" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Margin="1,0,0,0" />
                                </Border>
                            </Grid>
                        </Button>

                        <Button x:Name="NextButton" Style="{StaticResource IconButtonStyle}"
                                Width="40" Height="40" Margin="10,8,0,0"
                                Background="#F7F2FE" ToolTip="Следующий трек">
                            <TextBlock Text="&#xE893;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                Margin="0,7,0,0">
                        <TextBlock Text="&#xE767;" FontFamily="{StaticResource IconFont}"
                                   FontSize="12" Foreground="{StaticResource OnSurfaceMutedBrush}"
                                   VerticalAlignment="Center" />
                        <Slider x:Name="VolumeSlider" Style="{StaticResource VolumeSliderStyle}"
                                Width="110" Minimum="0" Maximum="1" Value="0.7"
                                Margin="7,0,7,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="VolumeText" Text="70" FontFamily="{StaticResource TextFont}"
                                   FontSize="10" Foreground="{StaticResource OnSurfaceMutedBrush}"
                                   VerticalAlignment="Center" Width="20" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== QUEUE ==================== -->
        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18,16,18,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Очередь" Style="{StaticResource H2TextStyle}" FontSize="20" />
                        <Border Style="{StaticResource ChipStyle}" Margin="9,1,0,0"
                                VerticalAlignment="Center" Background="#0F6850E8" Padding="9,3">
                            <TextBlock x:Name="TrackCountText" Text="0"
                                       FontFamily="{StaticResource TextFont}" FontSize="10"
                                       FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Нажмите на трек, чтобы включить"
                               Style="{StaticResource CaptionTextStyle}" FontSize="10.5"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,7,0,0">
                    <ListBox x:Name="PlaylistBox" Style="{StaticResource TrackListStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="11"
                                            Background="#F1EBFA" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}"
                                                   FontSize="13" Foreground="{StaticResource PrimaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,10,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   FontFamily="{StaticResource TextFont}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource OnSurfaceBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Artist}"
                                                   FontFamily="{StaticResource TextFont}"
                                                   FontSize="10.5"
                                                   Foreground="{StaticResource OnSurfaceMutedBrush}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="#0F6850E8" CornerRadius="7"
                                            Padding="6,3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Badge}"
                                                   FontFamily="{StaticResource TextFont}"
                                                   FontSize="8.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryBrush}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border x:Name="EmptyState" Background="#FAF7FF" CornerRadius="20"
                            Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    MaxWidth="310" Margin="18">
                            <Border Width="66" Height="66" CornerRadius="24"
                                    Background="{StaticResource PrimaryContainerBrush}"
                                    HorizontalAlignment="Center">
                                <TextBlock x:Name="EmptyIcon" Text="&#xE8B7;"
                                           FontFamily="{StaticResource IconFont}" FontSize="27"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="EmptyTitleText" Text="Здесь появится музыка"
                                       Style="{StaticResource H2TextStyle}" FontSize="18"
                                       HorizontalAlignment="Center" Margin="0,13,0,0" />
                            <TextBlock x:Name="EmptyHintText"
                                       Text="Выберите папку — Lumen найдёт MP3, WAV, FLAC и другие треки."
                                       Style="{StaticResource CaptionTextStyle}" FontSize="11.5"
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" Margin="0,4,0,0" LineHeight="17" />
                            <Button x:Name="EmptyChooseButton" Style="{StaticResource TonalButtonStyle}"
                                    Content="Выбрать папку" Height="38" Padding="18,0"
                                    HorizontalAlignment="Center" Margin="0,14,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Height="60" CornerRadius="19" Background="#F8F3FF"
                        BorderBrush="#0F6850E8" BorderThickness="1" Margin="0,10,0,0"
                        Padding="12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="34" Height="34" CornerRadius="12"
                                Background="{StaticResource PrimaryContainerBrush}"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#xE701;" FontFamily="{StaticResource IconFont}"
                                       FontSize="14" Foreground="{StaticResource PrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="Слушать на других устройствах"
                                       FontFamily="{StaticResource TextFont}" FontSize="11.5"
                                       FontWeight="SemiBold" Foreground="{StaticResource OnSurfaceBrush}" />
                            <TextBlock x:Name="StreamUrlText" Text="http://localhost:8737"
                                       FontFamily="{StaticResource TextFont}" FontSize="10.5"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Button x:Name="CopyStreamButton" Grid.Column="2"
                                Style="{StaticResource IconButtonStyle}" Width="32" Height="32"
                                Background="Transparent" ToolTip="Скопировать ссылку">
                            <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                        </Button>
                        <Button x:Name="OpenStreamButton" Grid.Column="3"
                                Style="{StaticResource IconButtonStyle}" Width="32" Height="32"
                                Background="Transparent" ToolTip="Открыть веб-плеер">
                            <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Grid>
