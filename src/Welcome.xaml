<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <StackPanel x:Name="Hero" VerticalAlignment="Center" HorizontalAlignment="Center"
                Margin="0,2,0,8">

        <TextBlock Text="АУРОРА" Style="{StaticResource LabelTextStyle}"
                   HorizontalAlignment="Center" FontSize="10" Opacity="0.85" />

        <Border Width="68" Height="68" CornerRadius="17" Margin="0,15,0,0"
                HorizontalAlignment="Center" BorderBrush="#33FFFFFF" BorderThickness="2"
                Background="{StaticResource BrandGradientBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270"
                                  Color="#8B5CF6" Opacity="0.40" />
            </Border.Effect>
            <TextBlock x:Name="UserInitialText" Text="&#xE8D6;" FontFamily="{StaticResource IconFont}"
                       FontSize="26" Foreground="#000000"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2" />
        </Border>

        <TextBlock x:Name="GreetingText" Text="Добро пожаловать" Style="{StaticResource DisplayTextStyle}"
                   FontSize="38" HorizontalAlignment="Center" Margin="0,15,0,0" />
        <TextBlock x:Name="UserNameText" Visibility="Collapsed" />

        <TextBlock x:Name="SubtitleText"
                   Text="Ваше личное музыкальное пространство. Локальная музыка и трансляция звука из любых приложений."
                   Style="{StaticResource BodyTextStyle}" FontSize="15.5" TextAlignment="Center"
                   HorizontalAlignment="Center" MaxWidth="620" TextWrapping="Wrap"
                   Margin="0,8,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">
            <!-- ==================== LOCAL MUSIC ==================== -->
            <Button x:Name="LocalCardButton" Style="{StaticResource BareButtonStyle}"
                    Width="320" Height="200" Margin="10,0" ToolTip="Открыть музыку из папки на компьютере">
                <Grid Width="320" Height="200" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="LocalScale" />
                            <TranslateTransform x:Name="LocalTranslate" />
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Border CornerRadius="26">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#8B5CF6" Offset="0" />
                                <GradientStop Color="#6D28D9" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="32" ShadowDepth="12" Direction="270"
                                              Color="#6D28D9" Opacity="0.35" />
                        </Border.Effect>
                        <Grid ClipToBounds="True">
                            <Canvas IsHitTestVisible="False">
                                <Ellipse Width="240" Height="240" Canvas.Left="190" Canvas.Top="-100"
                                         Stroke="#2BFFFFFF" StrokeThickness="1" />
                                <Ellipse Width="160" Height="160" Canvas.Left="230" Canvas.Top="-60"
                                         Stroke="#22FFFFFF" StrokeThickness="1" />
                                <Ellipse Width="120" Height="120" Canvas.Left="-50" Canvas.Top="150"
                                         Stroke="#1EFFFFFF" StrokeThickness="1" />
                            </Canvas>

                            <StackPanel Margin="26,24,26,22">
                                <Border Width="50" Height="50" CornerRadius="16" Background="#2EFFFFFF"
                                        HorizontalAlignment="Left">
                                    <Viewbox Width="24" Height="24" HorizontalAlignment="Center"
                                             VerticalAlignment="Center">
                                        <Path Fill="#000000"
                                              Data="M2.5,7 L2.5,5.5 C2.5,4.4 3.4,3.5 4.5,3.5 L8.5,3.5 C8.9,3.5 9.3,3.7 9.6,4 L11.2,6 L19.5,6 C20.6,6 21.5,6.9 21.5,8 L21.5,18 C21.5,19.1 20.6,20 19.5,20 L4.5,20 C3.4,20 2.5,19.1 2.5,18 Z" />
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="Локальная музыка" FontFamily="{StaticResource DisplayFont}"
                                           FontSize="23" FontWeight="SemiBold" Foreground="#000000"
                                           Margin="0,17,0,0" />
                                <TextBlock Text="Папка, плейлист и ваши любимые треки"
                                           FontFamily="{StaticResource TextFont}" FontSize="13"
                                           Foreground="#3A3A4A" TextWrapping="Wrap"
                                           Width="240" Margin="0,4,0,0" LineHeight="18" />
                            </StackPanel>

                            <Border Width="40" Height="40" CornerRadius="20" Background="#2BFFFFFF"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="0,0,22,22">
                                <TextBlock Text="&#xE72A;" FontFamily="{StaticResource IconFont}"
                                           FontSize="15" Foreground="#000000"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Button>

            <!-- ==================== SYSTEM AUDIO ==================== -->
            <Button x:Name="CaptureCardButton" Style="{StaticResource BareButtonStyle}"
                    Width="320" Height="200" Margin="10,0" ToolTip="Захватить системный звук с любых приложений">
                <Grid Width="320" Height="200" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="CaptureScale" />
                            <TranslateTransform x:Name="CaptureTranslate" />
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Border CornerRadius="26">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#F472B6" Offset="0" />
                                <GradientStop Color="#BE185D" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="32" ShadowDepth="12" Direction="270"
                                              Color="#BE185D" Opacity="0.32" />
                        </Border.Effect>
                        <Grid ClipToBounds="True">
                            <Canvas IsHitTestVisible="False">
                                <Ellipse Width="240" Height="240" Canvas.Left="190" Canvas.Top="-100"
                                         Stroke="#2BFFFFFF" StrokeThickness="1" />
                                <Ellipse Width="160" Height="160" Canvas.Left="230" Canvas.Top="-60"
                                         Stroke="#22FFFFFF" StrokeThickness="1" />
                                <Ellipse Width="120" Height="120" Canvas.Left="-50" Canvas.Top="150"
                                         Stroke="#1EFFFFFF" StrokeThickness="1" />
                            </Canvas>

                            <StackPanel Margin="26,24,26,22">
                                <Border Width="50" Height="50" CornerRadius="16" Background="#2EFFFFFF"
                                        HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                HorizontalAlignment="Center">
                                        <Border Width="3" Height="14" CornerRadius="2" Background="#000000"
                                                Margin="1.5,0" />
                                        <Border Width="3" Height="24" CornerRadius="2" Background="#000000"
                                                Margin="1.5,0" />
                                        <Border Width="3" Height="18" CornerRadius="2" Background="#000000"
                                                Margin="1.5,0" />
                                        <Border Width="3" Height="10" CornerRadius="2" Background="#3A3A4A"
                                                Margin="1.5,0" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Захват звука" FontFamily="{StaticResource DisplayFont}"
                                           FontSize="23" FontWeight="SemiBold" Foreground="#000000"
                                           Margin="0,17,0,0" />
                                <TextBlock Text="Системный звук из плеера, браузера или игры"
                                           FontFamily="{StaticResource TextFont}" FontSize="13"
                                           Foreground="#3A3A4A" TextWrapping="Wrap"
                                           Width="240" Margin="0,4,0,0" LineHeight="18" />
                            </StackPanel>

                            <Border Width="40" Height="40" CornerRadius="20" Background="#2BFFFFFF"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="0,0,22,22">
                                <TextBlock Text="&#xE72A;" FontFamily="{StaticResource IconFont}"
                                           FontSize="15" Foreground="#000000"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Button>
        </StackPanel>

        <Border HorizontalAlignment="Center" Margin="0,24,0,0" Background="#14121E"
                BorderBrush="#2A2240" BorderThickness="1" CornerRadius="20" Padding="14,8">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="NetworkDot" Width="8" Height="8" Fill="{StaticResource SuccessBrush}"
                         VerticalAlignment="Center" Margin="0,0,9,0" />
                <TextBlock x:Name="StreamStatusText" Text="Стриминг по Wi-Fi"
                           Style="{StaticResource CaptionTextStyle}" FontSize="12"
                           Foreground="{StaticResource OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="StreamUrlText" Text="http://192.168.0.10:8737"
                           Style="{StaticResource CaptionTextStyle}" FontSize="12"
                           Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"
                           Margin="8,0,0,0" />
                <Border Width="1" Height="14" Background="{StaticResource OutlineBrush}"
                        Margin="10,0" VerticalAlignment="Center" />
                <Button x:Name="OpenWebButton" Content="Открыть веб-плеер"
                        Style="{StaticResource TextButtonStyle}" FontSize="12" Padding="8,3" />
            </StackPanel>
        </Border>
    </StackPanel>
</Grid>